{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS"
  },
  "deploy": {
    "startCommand": "npm run start",
    "healthcheckPath": "/api/health",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  },
  "crons": [
    {
      "schedule": "*/2 * * * *",
      "endpoint": "/api/cron?job=sync-volumes",
      "timeoutSeconds": 120
    },
    {
      "schedule": "* * * * *",
      "endpoint": "/api/cron?job=check-expired",
      "timeoutSeconds": 60
    },
    {
      "schedule": "*/5 * * * *",
      "endpoint": "/api/cron?job=sync-traders",
      "timeoutSeconds": 120
    },
    {
      "schedule": "0 * * * *",
      "endpoint": "/api/cron?job=cleanup",
      "timeoutSeconds": 60
    }
  ]
}
