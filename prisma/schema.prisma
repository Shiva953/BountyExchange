generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model trader {
  id              Int       @id @default(autoincrement())
  name            String?
  address         String    @unique
  imageUrl        String?
  volumeCompleted Decimal?  @db.Decimal
  activeBounties  Int?
  createdAt       DateTime  @default(now())
  deals           deal[]    @relation("TraderDeals")

  // Telegram integration
  telegramUserId   String?   @unique
  telegramLinkedAt DateTime?
  notificationSettings notification_settings?

  @@index([name])
  @@index([telegramUserId])
}

model deal {
  id                    Int       @id @default(autoincrement())
  publicKey             String    @unique // On-chain deal PDA
  dealId                String    // On-chain deal ID (stored as string for BigInt)
  creator               String    // Creator wallet address
  token                 String    // Token mint address
  traderId              Int
  trader                trader    @relation("TraderDeals", fields: [traderId], references: [id])
  traderAddress         String    // Trader wallet address (denormalized for quick queries)
  rewardAmount          Decimal   @db.Decimal // In raw units (with decimals)
  targetVolume          Decimal   @db.Decimal // In raw units
  minBuyVolume          Decimal?  @db.Decimal // Optional min buy volume
  expirationHours       Int
  holdDurationHours     Int
  escrowVault           String
  createdAt             DateTime  // On-chain creation timestamp
  expiresAt             DateTime? // Calculated: acceptedAt + expirationHours (null until accepted)
  acceptedAt            DateTime? // When trader accepted the deal
  finalizedAt           DateTime? // When deal was finalized
  isActive              Boolean   @default(true)
  isAccepted            Boolean   @default(false)
  volumeCompleted       Decimal?  @db.Decimal // Tracked volume progress (updated by cron)
  outcome               String?   // "won" | "lost" | null (set on finalization)

  @@index([traderAddress])
  @@index([traderId])
  @@index([expiresAt])
  @@index([isActive, isAccepted])
}

// Notification preferences per trader
model notification_settings {
  id                 Int      @id @default(autoincrement())
  traderId           Int      @unique
  trader             trader   @relation(fields: [traderId], references: [id])

  // What to notify
  newBountyAvailable Boolean  @default(true)
  dealAccepted       Boolean  @default(true)
  progressMilestones Boolean  @default(true)
  dailySummary       Boolean  @default(true)
  expiryWarnings     Boolean  @default(true)
  dealFinalized      Boolean  @default(true)

  // Milestone thresholds (percentage values)
  milestoneThresholds Int[]   @default([25, 50, 75, 90])

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// Track sent notifications to prevent duplicates
model notification_log {
  id        Int      @id @default(autoincrement())
  traderId  Int
  dealId    Int?
  type      String   // "milestone_25", "expiry_24h", "finalized_won", etc.
  sentAt    DateTime @default(now())
  messageId String?  // Telegram message ID for potential edits

  @@unique([traderId, dealId, type])
  @@index([traderId])
  @@index([dealId])
}

// Pending wallet verifications for Telegram linking
model wallet_verification {
  id             Int      @id @default(autoincrement())
  telegramUserId String
  walletAddress  String
  verifyCode     String   @unique
  expiresAt      DateTime
  verified       Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([telegramUserId])
  @@index([verifyCode])
}
